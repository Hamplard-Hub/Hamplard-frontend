# Hamplard Frontend — Environment Variables
# Copy to .env.local

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_USDC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_PLATFORM_NAME=Hamplard

# Site URL for canonical URLs and SEO metadata (include protocol, no trailing slash)
# Defaults to https://hamplard.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Stripe — publishable (client-side) key only. Card payments are disabled when unset.
# Find yours at https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
